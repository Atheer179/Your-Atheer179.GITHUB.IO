            "dt_seconds": estimate["dt_seconds"],
            "camera_offset_anchor_ms": (
                anchor["records"][camera]["timestamp"]
                - anchor["records"]["CAM_FRONT"]["timestamp"]
            ) / 1000.0,
            "camera_offset_target_ms": (
                target["records"][camera]["timestamp"]
                - target["records"]["CAM_FRONT"]["timestamp"]
            ) / 1000.0,
            "anchor_landmarks": estimate["anchor_landmarks"],
            "klt_tracks": estimate["klt_tracks"],
            "descriptor_matches_added": estimate["descriptor_matches_added"],
            "correspondences": estimate["correspondences"],
            "pnp_ransac_inliers": estimate["pnp_ransac_inliers"],
            "pnp_inliers": estimate["pnp_inliers"],
            "median_reprojection_px": estimate["median_reprojection_px"],
            "success": estimate["success"],
            "reason": estimate["reason"],
            "pnp_refinement_error": estimate["pnp_refinement_error"],
            "fusion_accepted": estimate["fusion_accepted"],
            "fusion_translation_disagreement_m": "",
            "fusion_rotation_disagreement_deg": "",
            "gt_translation_error_m": estimate["gt_translation_error_m"],
            "gt_rotation_error_deg": estimate["gt_rotation_error_deg"],
        })
        camera_estimates.append(estimate)

    fused, accepted = fuse_motion(camera_estimates)

    # Update the per-camera CSV rows with fusion-consistency decisions.
    row_start = len(camera_rows) - len(camera_estimates)
    for i, estimate in enumerate(camera_estimates):
        camera_rows[row_start + i]["fusion_accepted"] = estimate["fusion_accepted"]
        camera_rows[row_start + i]["fusion_translation_disagreement_m"] = (
            estimate["fusion_translation_disagreement_m"]
        )
        camera_rows[row_start + i]["fusion_rotation_disagreement_deg"] = (
            estimate["fusion_rotation_disagreement_deg"]
        )

    if fused is None:
        motion_rows.append({
            "anchor_bundle_index": anchor_idx,
            "target_bundle_index": target_idx,
            "success": False,
            "accepted_cameras": "",
            "reason": "no_camera_pnp_succeeded",
            "translation_x_m": "",
            "translation_y_m": "",
            "translation_z_m": "",
        })
        trajectory.append({
            "bundle_index": target_idx,
            "timestamp": target["sample"]["timestamp"],
            "anchor_index": anchor_idx,
            "max_camera_offset_ms": max_camera_offset_us(target) / 1000.0,
            "pose_estimated": False,
            "x_m": "",
            "y_m": "",
            "z_m": "",
        })
        continue

    T_target_anchor = np.eye(4)
    T_target_anchor[:3, :3] = fused["R"]
    T_target_anchor[:3, 3] = fused["t"]

    # PnP transform maps anchor-body coordinates into target-body coordinates.
    target_pose_world = anchor_pose_world @ np.linalg.inv(T_target_anchor)
    position = target_pose_world[:3, 3]

    estimated_transforms.append({
        "anchor_bundle_index": anchor_idx,
        "target_bundle_index": target_idx,
        "R": fused["R"].copy(),
        "t": fused["t"].copy(),
    })
    motion_rows.append({
        "anchor_bundle_index": anchor_idx,
        "target_bundle_index": target_idx,
        "success": True,
        "accepted_cameras": ";".join(fused["accepted_cameras"]),
        "reason": "",
        "translation_x_m": fused["t"][0],
        "translation_y_m": fused["t"][1],
        "translation_z_m": fused["t"][2],
    })
    trajectory.append({
        "bundle_index": target_idx,
        "timestamp": target["sample"]["timestamp"],
        "anchor_index": anchor_idx,
        "max_camera_offset_ms": max_camera_offset_us(target) / 1000.0,
        "pose_estimated": True,
        "x_m": position[0],
        "y_m": position[1],
        "z_m": position[2],
    })

    # Refresh only after a successful pose and a usable new map. If motion
    # estimation fails, the previous anchor remains available for relocalizing
    # against later samples.
    new_features, new_landmarks, _, new_stats = triangulate_landmarks(
        target, target_idx, "anchor_refresh"
    )
    stereo_rows.extend(new_stats)
    landmark_count = max(
        (len(v) for v in new_landmarks.values()), default=0
    )
    if landmark_count >= MIN_PNP_INLIERS:
        anchor_idx = target_idx
        anchor_features = new_features
        anchor_landmarks = new_landmarks
        anchor_pose_world = target_pose_world


# --------------------------- Ground-truth evaluation only ---------------------------

gt_positions = []
gt_rotations = []
for bundle in bundles:
    T = body_pose_from_record(bundle["records"]["CAM_FRONT"])
    if T is None:
        gt_positions.append([np.nan, np.nan, np.nan])
        gt_rotations.append(np.full((3, 3), np.nan))
    else:
        gt_positions.append(T[:3, 3])
        gt_rotations.append(T[:3, :3])

gt_positions = np.asarray(gt_positions, dtype=np.float64)
gt_rotations = np.asarray(gt_rotations, dtype=np.float64)
if not np.isfinite(gt_positions[0]).all():
    raise RuntimeError("Ground-truth pose missing for the first sample.")

# Express GT in the initial vehicle frame; no trajectory fitting/alignment.
gt_relative = (
    gt_rotations[0].T @ (gt_positions - gt_positions[0]).T
).T

vo_positions = np.full((len(bundles), 3), np.nan, dtype=np.float64)
for row in trajectory:
    if row["pose_estimated"]:
        i = row["bundle_index"]
        vo_positions[i] = [row["x_m"], row["y_m"], row["z_m"]]

evaluation_rows = []
for i, bundle in enumerate(bundles):
    valid = np.isfinite(vo_positions[i]).all() and np.isfinite(gt_relative[i]).all()
    evaluation_rows.append({
        "bundle_index": i,
        "timestamp": bundle["sample"]["timestamp"],
        "pose_estimated": bool(np.isfinite(vo_positions[i]).all()),
        "max_camera_offset_ms": max_camera_offset_us(bundle) / 1000.0,
        "gt_x_m_initial_vehicle_frame": gt_relative[i, 0],
        "gt_y_m_initial_vehicle_frame": gt_relative[i, 1],
        "gt_z_m_initial_vehicle_frame": gt_relative[i, 2],
        "vo_x_m": vo_positions[i, 0] if np.isfinite(vo_positions[i]).all() else "",
        "vo_y_m": vo_positions[i, 1] if np.isfinite(vo_positions[i]).all() else "",
        "vo_z_m": vo_positions[i, 2] if np.isfinite(vo_positions[i]).all() else "",
        "position_error_xy_m": (
            float(np.linalg.norm(vo_positions[i, :2] - gt_relative[i, :2]))
            if valid else ""
        ),
        "position_error_3d_m": (
            float(np.linalg.norm(vo_positions[i] - gt_relative[i]))
            if valid else ""
        ),
    })


def write_csv(path, rows):
    if not rows:
        return
    with path.open("w", newline="", encoding="utf-8") as f:
        writer = csv.DictWriter(f, fieldnames=list(rows[0].keys()))
        writer.writeheader()
        writer.writerows(rows)


write_csv(OUTPUT_DIR / "per_camera_diagnostics.csv", camera_rows)
write_csv(OUTPUT_DIR / "relative_motion.csv", motion_rows)
write_csv(OUTPUT_DIR / "trajectory_vs_ground_truth.csv", evaluation_rows)
write_csv(OUTPUT_DIR / "stereo_pair_diagnostics.csv", stereo_rows)

