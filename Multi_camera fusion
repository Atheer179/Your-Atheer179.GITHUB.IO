# --------------------------- Stereo landmark map ---------------------------

def triangulate_landmarks(bundle, bundle_index, map_role):
    features = {}
    calibrations = {}
    landmarks_by_camera = {cam: {} for cam in CAMERAS}
    pair_stats = []

    for cam in CAMERAS:
        record = bundle["records"][cam]
        gray, keypoints, descriptors = extract_features(record["filename"])
        features[cam] = {
            "gray": gray,
            "keypoints": keypoints,
            "descriptors": descriptors,
            "record": record,
        }
        calibrations[cam] = camera_calibration(record)

    # This treats the three views as one rigid stereo rig at a common instant.
    # Timestamp offsets are logged and bounded, but not motion-compensated.
    if max_camera_offset_us(bundle) > MAX_CAMERA_OFFSET_US:
        for cam_a, cam_b in combinations(CAMERAS, 2):
            pair_stats.append({
                "bundle_index": bundle_index,
                "map_role": map_role,
                "camera_a": cam_a,
                "camera_b": cam_b,
                "mutual_matches": 0,
                "fundamental_ransac_inliers": 0,
                "calibrated_epipolar_inliers": 0,
                "finite_triangulations": 0,
                "positive_depth_triangulations": 0,
                "reprojection_inliers": 0,
                "failure_reason": "camera_timestamp_offset_exceeds_limit",
            })
        return features, landmarks_by_camera, calibrations, pair_stats

    for cam_a, cam_b in combinations(CAMERAS, 2):
        fa, fb = features[cam_a], features[cam_b]
        matches = mutual_ratio_matches(fa["descriptors"], fb["descriptors"])
        stats = {
            "bundle_index": bundle_index,
            "map_role": map_role,
            "camera_a": cam_a,
            "camera_b": cam_b,
            "mutual_matches": len(matches),
            "fundamental_ransac_inliers": 0,
            "calibrated_epipolar_inliers": 0,
            "finite_triangulations": 0,
            "positive_depth_triangulations": 0,
            "reprojection_inliers": 0,
            "failure_reason": "",
        }

        if len(matches) < 8:
            stats["failure_reason"] = "too_few_mutual_matches"
            pair_stats.append(stats)
            continue

        uv_a = np.float64([fa["keypoints"][m.queryIdx].pt for m in matches])
        uv_b = np.float64([fb["keypoints"][m.trainIdx].pt for m in matches])
        try:
            _, ransac_mask = cv2.findFundamentalMat(
                uv_a,
                uv_b,
                cv2.FM_RANSAC,
                STEREO_EPIPOLAR_RANSAC_PX,
                0.999,
            )
        except cv2.error as exc:
            stats["failure_reason"] = f"fundamental_ransac_error: {exc}"
            pair_stats.append(stats)
            continue

        if ransac_mask is None:
            stats["failure_reason"] = "fundamental_ransac_failed"
            pair_stats.append(stats)
            continue

        ransac_inliers = ransac_mask.reshape(-1).astype(bool)
        stats["fundamental_ransac_inliers"] = int(ransac_inliers.sum())
        calibrated_F = calibrated_fundamental_matrix(
            calibrations[cam_a], calibrations[cam_b]
        )
        calibrated_inliers = (
            calibrated_sampson_errors(calibrated_F, uv_a, uv_b)
            < CALIBRATED_EPIPOLAR_PX
        )
        geometric_inliers = ransac_inliers & calibrated_inliers
        stats["calibrated_epipolar_inliers"] = int(geometric_inliers.sum())
        if stats["calibrated_epipolar_inliers"] < 8:
            stats["failure_reason"] = "too_few_calibrated_epipolar_inliers"
            pair_stats.append(stats)
            continue

        geometric_indices = np.flatnonzero(geometric_inliers)
        uv_a_geometric = uv_a[geometric_indices]
        uv_b_geometric = uv_b[geometric_indices]

        X_h = cv2.triangulatePoints(
            calibrations[cam_a]["P"],
            calibrations[cam_b]["P"],
            uv_a_geometric.T,
            uv_b_geometric.T,
        )
        w = X_h[3]
        finite_w = np.abs(w) > 1e-9
        X_B = np.full((len(geometric_indices), 3), np.nan, dtype=np.float64)
        X_B[finite_w] = (X_h[:3, finite_w] / w[finite_w]).T
        finite = finite_w & np.isfinite(X_B).all(axis=1)
        stats["finite_triangulations"] = int(finite.sum())

        ca, cb = calibrations[cam_a], calibrations[cam_b]
        X_Ca = (ca["R_CB"] @ (X_B - ca["t_BC"]).T).T
        X_Cb = (cb["R_CB"] @ (X_B - cb["t_BC"]).T).T

        valid = (
            finite
            & (X_Ca[:, 2] > 0.1) & (X_Cb[:, 2] > 0.1)
            & (X_Ca[:, 2] < MAX_DEPTH_M) & (X_Cb[:, 2] < MAX_DEPTH_M)
        )
        stats["positive_depth_triangulations"] = int(valid.sum())

        indices = np.flatnonzero(valid)
        err_a = np.full(len(geometric_indices), np.inf)
        err_b = np.full(len(geometric_indices), np.inf)
        if len(indices):
            err_a[indices] = np.linalg.norm(
                project_points(ca["K"], X_Ca[indices])
                - uv_a_geometric[indices],
                axis=1,
            )
            err_b[indices] = np.linalg.norm(
                project_points(cb["K"], X_Cb[indices])
                - uv_b_geometric[indices],
                axis=1,
            )

        valid &= (err_a < STEREO_REPROJECTION_PX) & (
            err_b < STEREO_REPROJECTION_PX
        )
        stats["reprojection_inliers"] = int(valid.sum())
        if not stats["reprojection_inliers"]:
            stats["failure_reason"] = "no_valid_triangulations"
        pair_stats.append(stats)

        for idx in np.flatnonzero(valid):
            match = matches[geometric_indices[idx]]
            xyz = X_B[idx].copy()
            quality = float(err_a[idx] + err_b[idx])
            for cam, kp_idx in (
                (cam_a, match.queryIdx),
                (cam_b, match.trainIdx),
            ):
                old = landmarks_by_camera[cam].get(kp_idx)
                if old is None or quality < old[1]:
                    landmarks_by_camera[cam][kp_idx] = (xyz, quality)

    return features, landmarks_by_camera, calibrations, pair_stats


# --------------------------- PnP motion estimation ---------------------------

def estimate_camera_motion(camera, anchor_features, anchor_landmarks, target_bundle):
    f0 = anchor_features[camera]
    record1 = target_bundle["records"][camera]
    gray1, keypoints1, desc1 = extract_features(record1["filename"])
    record0 = f0["record"]
    dt = (record1["timestamp"] - record0["timestamp"]) / 1e6

    result = {
        "camera": camera,
        "dt_seconds": dt,
        "anchor_landmarks": 0,
        "klt_tracks": 0,
        "descriptor_matches_added": 0,
        "correspondences": 0,
        "pnp_ransac_inliers": 0,
        "pnp_inliers": 0,
        "success": False,
        "reason": "",
        "pnp_refinement_error": "",
        "R": None,
        "t": None,
        "median_reprojection_px": "",
    }

    if dt <= 0:
        result["reason"] = "nonpositive_camera_time_interval"
        return result

    landmarks = anchor_landmarks[camera]
    result["anchor_landmarks"] = len(landmarks)
    keypoints0 = f0["keypoints"]
    observations = {}

    landmark_indices = [i for i in landmarks if i < len(keypoints0)]
    if landmark_indices:
        points0 = np.float32(
            [keypoints0[i].pt for i in landmark_indices]
        ).reshape(-1, 1, 2)

        lk_params = {
            "winSize": (31, 31),
            "maxLevel": 4,
            "criteria": (
                cv2.TERM_CRITERIA_EPS | cv2.TERM_CRITERIA_COUNT, 40, 0.01
            ),
        }
        points1, status_f, _ = cv2.calcOpticalFlowPyrLK(
            f0["gray"], gray1, points0, None, **lk_params
        )

        if points1 is not None and status_f is not None:
            points0_back, status_b, _ = cv2.calcOpticalFlowPyrLK(
                gray1, f0["gray"], points1, None, **lk_params
            )
            if points0_back is not None and status_b is not None:
                p0 = points0.reshape(-1, 2)
                p1 = points1.reshape(-1, 2)
                p0b = points0_back.reshape(-1, 2)
                fb_error = np.linalg.norm(p0b - p0, axis=1)
                h, w = gray1.shape
                inside = (
                    (p1[:, 0] >= 0) & (p1[:, 0] < w)
                    & (p1[:, 1] >= 0) & (p1[:, 1] < h)
                )
                good = (
                    status_f.reshape(-1).astype(bool)
                    & status_b.reshape(-1).astype(bool)
                    & (fb_error < 1.5)
                    & inside
                    & np.isfinite(p1).all(axis=1)
                )
                for local_idx in np.flatnonzero(good):
                    kp_idx = landmark_indices[local_idx]
                    xyz, _ = landmarks[kp_idx]
                    observations[kp_idx] = (xyz, p1[local_idx])
                result["klt_tracks"] = len(observations)

    # Mutual descriptor matches augment KLT, but do not replace a checked track.
    for match in mutual_ratio_matches(f0["descriptors"], desc1):
        kp_idx = match.queryIdx
        if kp_idx in landmarks and kp_idx not in observations:
            xyz, _ = landmarks[kp_idx]
            observations[kp_idx] = (
                xyz, np.asarray(keypoints1[match.trainIdx].pt, dtype=np.float64)
            )
            result["descriptor_matches_added"] += 1

    result["correspondences"] = len(observations)
    if len(observations) < MIN_PNP_INLIERS:
        result["reason"] = "fewer_correspondences_than_required_inliers"
        return result

    object_points = np.asarray(
        [v[0] for v in observations.values()], dtype=np.float32
    )
    image_points = np.asarray(
        [v[1] for v in observations.values()], dtype=np.float32
    )
    K = camera_calibration(record1)["K"]

    try:
        ok, rvec, tvec, inliers = cv2.solvePnPRansac(
            object_points,
            image_points,
            K,
            None,
            iterationsCount=600,
            reprojectionError=PNP_REPROJECTION_PX,
            confidence=0.999,
            flags=cv2.SOLVEPNP_EPNP,
        )
    except cv2.error as exc:
        result["reason"] = f"pnp_error: {exc}"
        return result

    n_inliers = 0 if inliers is None else len(inliers)
    result["pnp_ransac_inliers"] = n_inliers
    if not ok or inliers is None or n_inliers < MIN_PNP_INLIERS:
        result["reason"] = "pnp_failed_or_too_few_inliers"
        return result

    inlier_idx = inliers.ravel()
    try:
        refined, rvec_refined, tvec_refined = cv2.solvePnP(
            object_points[inlier_idx],
            image_points[inlier_idx],
            K,
            None,
            rvec,
            tvec,
            useExtrinsicGuess=True,
            flags=cv2.SOLVEPNP_ITERATIVE,
        )
        if refined:
            rvec, tvec = rvec_refined, tvec_refined
    except cv2.error as exc:
        result["pnp_refinement_error"] = str(exc)

    R_Ctarget_Banchor, _ = cv2.Rodrigues(rvec)
    t_Ctarget_Banchor = tvec.reshape(3)

    projected, _ = cv2.projectPoints(
        object_points[inlier_idx], rvec, tvec, K, None
    )
    residuals = np.linalg.norm(
        projected.reshape(-1, 2) - image_points[inlier_idx], axis=1
    )
    target_points = (
        R_Ctarget_Banchor @ object_points[inlier_idx].T
    ).T + t_Ctarget_Banchor
    valid_inliers = (
        np.isfinite(target_points).all(axis=1)
        & (target_points[:, 2] > 0.1)
        & np.isfinite(residuals)
        & (residuals < PNP_REPROJECTION_PX)
    )
    inlier_idx = inlier_idx[valid_inliers]
    residuals = residuals[valid_inliers]
    result["pnp_inliers"] = len(inlier_idx)
    if result["pnp_inliers"] < MIN_PNP_INLIERS:
        result["reason"] = "too_few_positive_depth_reprojection_inliers"
        return result

    calib = camera_calibration(record1)
    # Convert PnP's target-camera coordinates to target-body coordinates.
    R_Btarget_Banchor = calib["R_BC"] @ R_Ctarget_Banchor
    t_Btarget_Banchor = calib["R_BC"] @ t_Ctarget_Banchor + calib["t_BC"]

    result.update({
        "success": True,
        "reason": "",
        "R": R_Btarget_Banchor,
        "t": t_Btarget_Banchor,
        "median_reprojection_px": float(np.median(residuals)),
    })
    return result


def fuse_motion(estimates):
    candidates = [e for e in estimates if e["success"]]
    if not candidates:
        return None, []

    reference = max(candidates, key=lambda e: e["pnp_inliers"])
    R_ref, t_ref = reference["R"], reference["t"]
    translation_gate = max(1.5, 0.35 * np.linalg.norm(t_ref) + 0.75)

    accepted = []
    for e in candidates:
        trans_err = float(np.linalg.norm(e["t"] - t_ref))
        rot_err = rotation_error_deg(e["R"], R_ref)
        e["fusion_accepted"] = (
            trans_err <= translation_gate and rot_err <= ROTATION_GATE_DEG
        )
        e["fusion_translation_disagreement_m"] = trans_err
        e["fusion_rotation_disagreement_deg"] = rot_err
        if e["fusion_accepted"]:
            accepted.append(e)

    weights = np.asarray(
        [max(e["pnp_inliers"], 1) for e in accepted], dtype=np.float64
    )
    weights /= weights.sum()
    t = np.sum(
        np.asarray([e["t"] for e in accepted]) * weights[:, None], axis=0
    )
    R = Rotation.from_matrix(
        np.asarray([e["R"] for e in accepted])
    ).mean(weights=weights).as_matrix()

    return {
        "R": R,
        "t": t,
        "accepted_cameras": [e["camera"] for e in accepted],
    }, accepted


