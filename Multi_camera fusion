def body_pose_from_record(record):
    """T_global_body at this record's timestamp; used only for evaluation."""
    pose = ego_pose_by_token.get(record.get("ego_pose_token"))
    if pose is None:
        return None

    q = pose["rotation"]  # nuScenes order is [w, x, y, z].
    R_global_body = Rotation.from_quat([q[1], q[2], q[3], q[0]]).as_matrix()
    T = np.eye(4)
    T[:3, :3] = R_global_body
    T[:3, 3] = np.asarray(pose["translation"], dtype=np.float64)
    return T


def camera_calibration(record):
    calib = calibrated_by_token[record["calibrated_sensor_token"]]
    q = calib["rotation"]  # sensor-to-ego rotation, [w, x, y, z].
    R_BC = Rotation.from_quat([q[1], q[2], q[3], q[0]]).as_matrix()
    t_BC = np.asarray(calib["translation"], dtype=np.float64)
    R_CB = R_BC.T
    t_CB = -R_CB @ t_BC
    K = np.asarray(calib["camera_intrinsic"], dtype=np.float64)
    P = K @ np.column_stack((R_CB, t_CB))
    return {"K": K, "R_BC": R_BC, "t_BC": t_BC, "R_CB": R_CB, "P": P}


@lru_cache(maxsize=9)
def extract_features(filename):
    image_path = DATA_DIR / filename
    image = cv2.imread(str(image_path))
    if image is None:
        raise FileNotFoundError(f"Could not read image: {image_path}")

    gray = cv2.cvtColor(image, cv2.COLOR_BGR2GRAY)
    keypoints, descriptors = sift.detectAndCompute(gray, None)
    return gray, keypoints, descriptors


def mutual_ratio_matches(desc0, desc1):
    """Ratio-test matches that also agree in the reverse matching direction."""
    if desc0 is None or desc1 is None or len(desc0) < 2 or len(desc1) < 2:
        return []

    forward = matcher.knnMatch(desc0, desc1, k=2)
    reverse = matcher.knnMatch(desc1, desc0, k=2)

    fwd = [
        m for pair in forward if len(pair) == 2
        for m in [pair[0]]
        if pair[0].distance < RATIO_TEST * pair[1].distance
    ]
    rev_pairs = [
        (pair[0].trainIdx, pair[0].queryIdx)
        for pair in reverse if len(pair) == 2
        and pair[0].distance < RATIO_TEST * pair[1].distance
    ]
    reverse_set = set(rev_pairs)
    return [m for m in fwd if (m.queryIdx, m.trainIdx) in reverse_set]


def project_points(K, xyz_camera):
    uv_h = (K @ xyz_camera.T).T
    return uv_h[:, :2] / uv_h[:, 2:3]


def skew_symmetric(vector):
    x, y, z = vector
    return np.array([
        [0.0, -z, y],
        [z, 0.0, -x],
        [-y, x, 0.0],
    ])


def calibrated_fundamental_matrix(calib_a, calib_b):
    """Return F mapping pixels in camera A to epipolar lines in camera B."""
    R_Cb_Ca = calib_b["R_CB"] @ calib_a["R_BC"]
    t_Cb_Ca = calib_b["R_CB"] @ (
        calib_a["t_BC"] - calib_b["t_BC"]
    )
    essential = skew_symmetric(t_Cb_Ca) @ R_Cb_Ca
    return (
        np.linalg.inv(calib_b["K"]).T
        @ essential
        @ np.linalg.inv(calib_a["K"])
    )


def calibrated_sampson_errors(F, uv_a, uv_b):
    points_a = np.column_stack((uv_a, np.ones(len(uv_a))))
    points_b = np.column_stack((uv_b, np.ones(len(uv_b))))
    F_points_a = (F @ points_a.T).T
    Ft_points_b = (F.T @ points_b.T).T
    numerator = np.abs(np.sum(points_b * F_points_a, axis=1))
    denominator = np.sqrt(
        F_points_a[:, 0] ** 2 + F_points_a[:, 1] ** 2
        + Ft_points_b[:, 0] ** 2 + Ft_points_b[:, 1] ** 2
    )
    errors = np.full(len(uv_a), np.inf, dtype=np.float64)
    valid = denominator > 1e-12
    errors[valid] = numerator[valid] / denominator[valid]
    return errors


def rotation_error_deg(R1, R2):
    return float(np.degrees(Rotation.from_matrix(R1 @ R2.T).magnitude()))


def max_camera_offset_us(bundle):
