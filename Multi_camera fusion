        estimate["fusion_translation_disagreement_m"] = ""
        estimate["fusion_rotation_disagreement_deg"] = ""

        # Per-camera relative-pose diagnostic against that camera's exact
        # image timestamps. This is evaluation only, never estimator input.
        if estimate["success"]:
            T_GA = body_pose_from_record(anchor["records"][camera])
            T_GT = body_pose_from_record(target["records"][camera])
            if T_GA is not None and T_GT is not None:
                T_target_anchor_gt = np.linalg.inv(T_GT) @ T_GA
                estimate["gt_translation_error_m"] = float(np.linalg.norm(
                    estimate["t"] - T_target_anchor_gt[:3, 3]
                ))
                estimate["gt_rotation_error_deg"] = rotation_error_deg(
                    estimate["R"], T_target_anchor_gt[:3, :3]
                )
            else:
                estimate["gt_translation_error_m"] = ""
                estimate["gt_rotation_error_deg"] = ""
        else:
            estimate["gt_translation_error_m"] = ""
            estimate["gt_rotation_error_deg"] = ""

        camera_rows.append({
            "anchor_bundle_index": anchor_idx,
            "target_bundle_index": target_idx,
